{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci && npm --prefix client ci",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "client/dist/**"
    }
  },
  "routes": [
    {
      "src": "/api(?:/.*)?",
      "dest": "/api/index.js"
    },
    {
      "src": "/health(?:/.*)?",
      "dest": "/api/index.js"
    },
    {
      "src": "/(?:index\\.html)?",
      "dest": "/api/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
