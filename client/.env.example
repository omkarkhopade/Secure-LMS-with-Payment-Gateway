# Used by the Vite development proxy; no server secrets belong here.
API_TARGET=http://127.0.0.1:8000
# Production defaults to /api/v1 through a same-origin reverse proxy.
VITE_API_BASE_URL=/api/v1
# Show only the providers you configured on the backend: razorpay,stripe
VITE_PAYMENT_PROVIDERS=razorpay,stripe
