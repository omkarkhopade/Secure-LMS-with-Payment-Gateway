NODE_ENV=development
PORT=8000
# MongoDB Atlas or a local replica set is required for transactions.
MONGO_URI=mongodb://127.0.0.1:27017/lms?replicaSet=rs0
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CLIENT_URL=http://localhost:5175
# Set to the EXACT number of trusted proxies; keep 0 for direct connections.
TRUST_PROXY_HOPS=0
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Configure either or both payment providers. Unconfigured routes return 503.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Required in production; missing in development disables the webhook endpoint.
RAZORPAY_WEBHOOK_SECRET=
# Default 50 MiB, one file per request; image and video formats are allowlisted.
MAX_FILE_SIZE=52428800
UPLOAD_PATH=./uploads
